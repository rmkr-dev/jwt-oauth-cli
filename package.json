{
  "name": "jwt-oauth-cli",
  "version": "0.1.0",
  "description": "CLI to decode/inspect JWTs, build OAuth authorize URLs, and exchange authorization codes locally",
  "type": "module",
  "bin": {
    "jwt-oauth-cli": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/cli.js && node --check src/jwt.js && node --check src/oauth.js && node --check src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jwt",
    "oauth",
    "cli",
    "oidc",
    "authorization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmkr-dev/jwt-oauth-cli.git"
  },
  "bugs": {
    "url": "https://github.com/rmkr-dev/jwt-oauth-cli/issues"
  },
  "homepage": "https://github.com/rmkr-dev/jwt-oauth-cli#readme",
  "dependencies": {
    "commander": "^12.1.0",
    "jose": "^5.9.6"
  }
}
